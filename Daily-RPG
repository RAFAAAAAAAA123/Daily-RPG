<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Productivity RPG</title>
    <style>
        :root {
            --primary: #4a6fa5;
            --secondary: #6b8cae;
            --accent: #ff9e44;
            --light: #f0f4f8;
            --dark: #2b3a4a;
            --success: #5cb85c;
            --danger: #d9534f;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f5f7fa;
            color: var(--dark);
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 20px 0;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        header h1 {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 10px;
        }
        
        .app {
            display: grid;
            grid-template-columns: 1fr 3fr;
            gap: 20px;
        }
        
        .sidebar {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .main-content {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .menu-button {
            display: block;
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.3s;
        }
        
        .menu-button:hover {
            background-color: var(--secondary);
        }
        
        .status-card {
            background-color: var(--light);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        
        .status-card h3 {
            color: var(--primary);
            margin-bottom: 10px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }
        
        .stat-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        
        .stat-name {
            font-weight: bold;
        }
        
        .world-card {
            background-color: var(--light);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
        }
        
        .inventory-item {
            display: inline-block;
            background-color: var(--secondary);
            color: white;
            padding: 5px 10px;
            border-radius: 15px;
            margin: 5px 5px 5px 0;
            font-size: 0.9rem;
        }
        
        .task-list {
            list-style-type: none;
        }
        
        .task-item {
            background-color: var(--light);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .task-info {
            flex: 1;
        }
        
        .task-difficulty {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 0.8rem;
            margin-right: 10px;
        }
        
        .difficulty-easy {
            background-color: #5cb85c;
            color: white;
        }
        
        .difficulty-medium {
            background-color: #f0ad4e;
            color: white;
        }
        
        .difficulty-hard {
            background-color: #d9534f;
            color: white;
        }
        
        .task-actions button {
            padding: 8px 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-left: 5px;
        }
        
        .btn-complete {
            background-color: var(--success);
            color: white;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        
        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        
        .btn-primary {
            background-color: var(--primary);
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        
        .shop-items {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
        }
        
        .shop-item {
            background-color: var(--light);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        
        .shop-item h4 {
            color: var(--primary);
            margin-bottom: 10px;
        }
        
        .shop-item p {
            margin-bottom: 10px;
        }
        
        .worlds-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .world-card {
            background-color: var(--light);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        
        .world-card h3 {
            color: var(--primary);
            margin-bottom: 10px;
        }
        
        .world-card p {
            margin-bottom: 15px;
        }
        
        .locked {
            opacity: 0.6;
            position: relative;
        }
        
        .locked::after {
            content: '🔒';
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 1.5rem;
        }
        
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 20px;
            border-radius: 5px;
            color: white;
            z-index: 1000;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s, transform 0.3s;
        }
        
        .notification.show {
            opacity: 1;
            transform: translateY(0);
        }
        
        .notification.success {
            background-color: var(--success);
        }
        
        .notification.info {
            background-color: var(--primary);
        }
        
        .notification.warning {
            background-color: var(--accent);
        }
        
        @media (max-width: 768px) {
            .app {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Daily Productivity RPG</h1>
            <p style="text-align: center;">Ubah produktivitasmu menjadi petualangan!</p>
        </header>
        
        <div id="notification" class="notification"></div>
        
        <div class="app">
            <div class="sidebar">
                <button class="menu-button" onclick="showSection('status')">Status Karakter</button>
                <button class="menu-button" onclick="showSection('tasks')">Daftar Tugas</button>
                <button class="menu-button" onclick="showSection('add-task')">Tambah Tugas</button>
                <button class="menu-button" onclick="showSection('shop')">Toko Item</button>
                <button class="menu-button" onclick="showSection('worlds')">Jelajahi Dunia</button>
                
                <div class="status-card">
                    <h3>Status Cepat</h3>
                    <div class="stat-row">
                        <span class="stat-name">Level:</span>
                        <span id="quick-level">1</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">EXP:</span>
                        <span id="quick-exp">0/100</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Gold:</span>
                        <span id="quick-gold">50</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Streak:</span>
                        <span id="quick-streak">0 hari</span>
                    </div>
                </div>
                
                <div class="world-card">
                    <h3>Dunia Saat Ini</h3>
                    <p id="current-world">Forest of Beginning</p>
                </div>
            </div>
            
            <div class="main-content">
                <div id="status-section" class="section">
                    <h2>Status Karakter</h2>
                    <div class="status-card">
                        <h3>Informasi Umum</h3>
                        <div class="stat-row">
                            <span class="stat-name">Nama:</span>
                            <span id="char-name">Petualang</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-name">Level:</span>
                            <span id="char-level">1</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-name">EXP:</span>
                            <span id="char-exp">0/100</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-name">Gold:</span>
                            <span id="char-gold">50</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-name">Tugas Diselesaikan:</span>
                            <span id="char-tasks">0</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-name">Streak:</span>
                            <span id="char-streak">0 hari</span>
                        </div>
                    </div>
                    
                    <div class="status-card">
                        <h3>Dunia yang Dibuka</h3>
                        <div id="unlocked-worlds">
                            <p>Forest of Beginning</p>
                        </div>
                    </div>
                    
                    <div class="status-card">
                        <h3>Inventory</h3>
                        <div id="inventory">
                            <p>Inventory kosong</p>
                        </div>
                    </div>
                </div>
                
                <div id="tasks-section" class="section" style="display: none;">
                    <h2>Daftar Tugas Anda</h2>
                    <div id="tasks-list">
                        <p>Memuat tugas...</p>
                    </div>
                </div>
                
                <div id="add-task-section" class="section" style="display: none;">
                    <h2>Tambah Tugas Baru</h2>
                    <form id="task-form">
                        <div class="form-group">
                            <label for="task-name">Nama Tugas</label>
                            <input type="text" id="task-name" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="task-difficulty">Tingkat Kesulitan</label>
                            <select id="task-difficulty" required>
                                <option value="easy">Mudah (+10 EXP, +5 Gold)</option>
                                <option value="medium">Sedang (+25 EXP, +15 Gold)</option>
                                <option value="hard">Sulit (+50 EXP, +30 Gold)</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="task-deadline">Deadline (opsional)</label>
                            <input type="date" id="task-deadline">
                        </div>
                        
                        <button type="submit" class="btn-primary">Tambah Tugas</button>
                    </form>
                </div>
                
                <div id="shop-section" class="section" style="display: none;">
                    <h2>Toko Item</h2>
                    <p>Gold Anda: <span id="shop-gold">50</span></p>
                    
                    <div class="shop-items">
                        <div class="shop-item">
                            <h4>Potion of Focus</h4>
                            <p>Menylesaikan tugas secara otomatis</p>
                            <p>Harga: 30 Gold</p>
                            <button class="btn-primary" onclick="buyItem('Potion of Focus')">Beli</button>
                        </div>
                        
                        <div class="shop-item">
                            <h4>Time Extender</h4>
                            <p>Menambah 1 jam ke deadline</p>
                            <p>Harga: 25 Gold</p>
                            <button class="btn-primary" onclick="buyItem('Time Extender')">Beli</button>
                        </div>
                        
                        <div class="shop-item">
                            <h4>Lucky Charm</h4>
                            <p>Meningkatkan EXP yang didapat 20%</p>
                            <p>Harga: 100 Gold</p>
                            <button class="btn-primary" onclick="buyItem('Lucky Charm')">Beli</button>
                        </div>
                        
                        <div class="shop-item">
                            <h4>Map of Clarity</h4>
                            <p>Menampilkan quest tersembunyi</p>
                            <p>Harga: 150 Gold</p>
                            <button class="btn-primary" onclick="buyItem('Map of Clarity')">Beli</button>
                        </div>
                    </div>
                </div>
                
                <div id="worlds-section" class="section" style="display: none;">
                    <h2>Jelajahi Dunia</h2>
                    <p>Dunia saat ini: <strong id="current-world-name">Forest of Beginning</strong></p>
                    
                    <div class="worlds-grid">
                        <div class="world-card">
                            <h3>Forest of Beginning</h3>
                            <p>A peaceful forest where your journey begins.</p>
                            <button class="btn-primary" onclick="travelToWorld('Forest of Beginning')">Jelajahi</button>
                        </div>
                        
                        <div class="world-card locked" id="mountain-world">
                            <h3>Mountain of Focus</h3>
                            <p>A tall mountain that requires intense focus to climb.</p>
                            <p><small>Butuh: Level 3 dan 15 tugas selesai</small></p>
                        </div>
                        
                        <div class="world-card locked" id="ocean-world">
                            <h3>Ocean of Creativity</h3>
                            <p>A vast ocean where ideas flow like water.</p>
                            <p><small>Butuh: 30 tugas selesai dan streak 7 hari</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Data player
        let playerData = {
            name: "Petualang",
            level: 1,
            exp: 0,
            exp_to_next_level: 100,
            gold: 50,
            tasks_completed: 0,
            streak: 0,
            last_login: null,
            inventory: [],
            unlocked_worlds: ["Forest of Beginning"],
            current_world: "Forest of Beginning",
            quests: []
        };
        
        // Items data
        const items = {
            "Potion of Focus": { type: "consumable", effect: "Completes a task automatically", price: 30 },
            "Time Extender": { type: "consumable", effect: "Adds 1 hour to your deadline", price: 25 },
            "Lucky Charm": { type: "equipment", effect: "Increases EXP gained by 20%", price: 100 },
            "Map of Clarity": { type: "equipment", effect: "Reveals hidden quests", price: 150 }
        };
        
        // Worlds data
        const worlds = {
            "Forest of Beginning": {
                description: "A peaceful forest where your journey begins.",
                unlock_requirement: "Complete 5 tasks",
                quests: ["Clear 3 tasks", "Maintain a 2-day streak"]
            },
            "Mountain of Focus": {
                description: "A tall mountain that requires intense focus to climb.",
                unlock_requirement: "Reach Level 3 and complete 15 tasks",
                quests: ["Complete 5 tasks in one day", "Reach a 5-day streak"]
            },
            "Ocean of Creativity": {
                description: "A vast ocean where ideas flow like water.",
                unlock_requirement: "Complete 30 tasks and have 7-day streak",
                quests: ["Create 3 original tasks", "Complete tasks for 3 days in a row"]
            }
        };
        
        // Initialize the game
        function initGame() {
            // Load saved data if available
            const savedData = localStorage.getItem('rpg_save');
            if (savedData) {
                playerData = JSON.parse(savedData);
                
                // Check login streak
                const today = new Date().toISOString().split('T')[0];
                if (playerData.last_login !== today) {
                    if (playerData.last_login) {
                        const lastDate = new Date(playerData.last_login);
                        const currentDate = new Date();
                        const diffTime = Math.abs(currentDate - lastDate);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        
                        if (diffDays === 1) {
                            playerData.streak++;
                            showNotification(`🔥 Streak continues! Day ${playerData.streak}`, 'success');
                        } else {
                            playerData.streak = 0;
                            showNotification('💔 Streak broken! Starting over.', 'warning');
                        }
                    }
                    
                    playerData.last_login = today;
                    saveGame();
                }
            } else {
                // New game setup
                playerData.name = prompt("What is your character's name?") || "Petualang";
                playerData.last_login = new Date().toISOString().split('T')[0];
                showNotification(`Welcome, ${playerData.name}! Your adventure begins in the Forest of Beginning.`, 'info');
                saveGame();
            }
            
            updateUI();
            checkWorldUnlocks();
        }
        
        // Save game data
        function saveGame() {
            localStorage.setItem('rpg_save', JSON.stringify(playerData));
        }
        
        // Show notification
        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type} show`;
            
            setTimeout(() => {
                notification.className = 'notification';
            }, 3000);
        }
        
        // Update UI with current player data
        function updateUI() {
            // Update status section
            document.getElementById('char-name').textContent = playerData.name;
            document.getElementById('char-level').textContent = playerData.level;
            document.getElementById('char-exp').textContent = `${playerData.exp}/${playerData.exp_to_next_level}`;
            document.getElementById('char-gold').textContent = playerData.gold;
            document.getElementById('char-tasks').textContent = playerData.tasks_completed;
            document.getElementById('char-streak').textContent = `${playerData.streak} hari`;
            
            // Update quick stats
            document.getElementById('quick-level').textContent = playerData.level;
            document.getElementById('quick-exp').textContent = `${playerData.exp}/${playerData.exp_to_next_level}`;
            document.getElementById('quick-gold').textContent = playerData.gold;
            document.getElementById('quick-streak').textContent = `${playerData.streak} hari`;
            document.getElementById('current-world').textContent = playerData.current_world;
            document.getElementById('current-world-name').textContent = playerData.current_world;
            
            // Update unlocked worlds
            const unlockedWorldsEl = document.getElementById('unlocked-worlds');
            unlockedWorldsEl.innerHTML = '';
            playerData.unlocked_worlds.forEach(world => {
                const p = document.createElement('p');
                p.textContent = world;
                unlockedWorldsEl.appendChild(p);
            });
            
            // Update inventory
            const inventoryEl = document.getElementById('inventory');
            inventoryEl.innerHTML = '';
            
            if (playerData.inventory.length === 0) {
                inventoryEl.innerHTML = '<p>Inventory kosong</p>';
            } else {
                playerData.inventory.forEach(item => {
                    const span = document.createElement('span');
                    span.className = 'inventory-item';
                    span.textContent = item;
                    inventoryEl.appendChild(span);
                });
            }
            
            // Update shop gold
            document.getElementById('shop-gold').textContent = playerData.gold;
            
            // Update tasks list
            updateTasksList();
        }
        
        // Update tasks list
        function updateTasksList() {
            const tasksListEl = document.getElementById('tasks-list');
            tasksListEl.innerHTML = '';
            
            const incompleteQuests = playerData.quests.filter(q => !q.completed);
            
            if (incompleteQuests.length === 0) {
                tasksListEl.innerHTML = '<p>Tidak ada tugas yang sedang berjalan. Tambahkan tugas baru!</p>';
                return;
            }
            
            incompleteQuests.forEach((quest, index) => {
                const taskItem = document.createElement('div');
                taskItem.className = 'task-item';
                
                const difficultyClass = `difficulty-${quest.difficulty}`;
                
                taskItem.innerHTML = `
                    <div class="task-info">
                        <h3>${quest.name}</h3>
                        <span class="task-difficulty ${difficultyClass}">${quest.difficulty}</span>
                        <span>Deadline: ${quest.deadline || 'Tidak ada'}</span>
                    </div>
                    <div class="task-actions">
                        <button class="btn-complete" onclick="completeTask(${index})">Selesai</button>
                    </div>
                `;
                
                tasksListEl.appendChild(taskItem);
            });
        }
        
        // Show section
        function showSection(sectionName) {
            // Hide all sections
            document.querySelectorAll('.section').forEach(section => {
                section.style.display = 'none';
            });
            
            // Show selected section
            document.getElementById(`${sectionName}-section`).style.display = 'block';
            
            // Special handling for certain sections
            if (sectionName === 'tasks') {
                updateTasksList();
            }
        }
        
        // Add new task
        document.getElementById('task-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const taskName = document.getElementById('task-name').value;
            const difficulty = document.getElementById('task-difficulty').value;
            const deadline = document.getElementById('task-deadline').value;
            
            let expReward = 0;
            let goldReward = 0;
            
            if (difficulty === 'easy') {
                expReward = 10;
                goldReward = 5;
            } else if (difficulty === 'medium') {
                expReward = 25;
                goldReward = 15;
            } else if (difficulty === 'hard') {
                expReward = 50;
                goldReward = 30;
            }
            
            const quest = {
                name: taskName,
                difficulty: difficulty,
                exp_reward: expReward,
                gold_reward: goldReward,
                deadline: deadline || new Date().toISOString().split('T')[0],
                completed: false
            };
            
            playerData.quests.push(quest);
            saveGame();
            
            showNotification(`Tugas "${taskName}" telah ditambahkan!`, 'success');
            document.getElementById('task-form').reset();
            
            updateTasksList();
        });
        
        // Complete task
        function completeTask(index) {
            const incompleteQuests = playerData.quests.filter(q => !q.completed);
            if (index < 0 || index >= incompleteQuests.length) return;
            
            const quest = incompleteQuests[index];
            const questIndex = playerData.quests.findIndex(q => q.name === quest.name && !q.completed);
            
            // Reward player
            playerData.exp += quest.exp_reward;
            playerData.gold += quest.gold_reward;
            playerData.tasks_completed++;
            playerData.quests[questIndex].completed = true;
            
            showNotification(`🎉 Tugas "${quest.name}" selesai! Dapat ${quest.exp_reward} EXP dan ${quest.gold_reward} Gold!`, 'success');
            
            // Check for level up
            if (playerData.exp >= playerData.exp_to_next_level) {
                levelUp();
            }
            
            // Check for world unlocks
            checkWorldUnlocks();
            
            // Random chance to find an item (20%)
            if (Math.random() < 0.2) {
                findRandomItem();
            }
            
            saveGame();
            updateUI();
        }
        
        // Level up
        function levelUp() {
            playerData.level++;
            playerData.exp -= playerData.exp_to_next_level;
            playerData.exp_to_next_level = Math.floor(playerData.exp_to_next_level * 1.5);
            
            showNotification(`🎇 LEVEL UP! Sekarang Level ${playerData.level}!`, 'success');
        }
        
        // Check world unlocks
        function checkWorldUnlocks() {
            const currentWorlds = [...playerData.unlocked_worlds];
            
            // Check for Mountain of Focus
            if (!playerData.unlocked_worlds.includes("Mountain of Focus")) {
                if (playerData.level >= 3 && playerData.tasks_completed >= 15) {
                    playerData.unlocked_worlds.push("Mountain of Focus");
                    showNotification("🏔️ Anda membuka dunia Mountain of Focus!", 'success');
                    document.getElementById('mountain-world').classList.remove('locked');
                }
            }
            
            // Check for Ocean of Creativity
            if (!playerData.unlocked_worlds.includes("Ocean of Creativity")) {
                if (playerData.tasks_completed >= 30 && playerData.streak >= 7) {
                    playerData.unlocked_worlds.push("Ocean of Creativity");
                    showNotification("🌊 Anda membuka dunia Ocean of Creativity!", 'success');
                    document.getElementById('ocean-world').classList.remove('locked');
                }
            }
            
            // Update UI if new worlds were unlocked
            if (playerData.unlocked_worlds.length > currentWorlds.length) {
                updateUI();
            }
        }
        
        // Find random item
        function findRandomItem() {
            const availableItems = Object.keys(items).filter(item => !playerData.inventory.includes(item));
            
            if (availableItems.length > 0) {
                const foundItem = availableItems[Math.floor(Math.random() * availableItems.length)];
                playerData.inventory.push(foundItem);
                
                showNotification(`🎁 Anda menemukan ${foundItem}! Efek: ${items[foundItem].effect}`, 'success');
            }
        }
        
        // Buy item from shop
        function buyItem(itemName) {
            const item = items[itemName];
            
            if (playerData.gold >= item.price) {
                playerData.gold -= item.price;
                playerData.inventory.push(itemName);
                
                saveGame();
                updateUI();
                
                showNotification(`Anda membeli ${itemName}!`, 'success');
            } else {
                showNotification('Gold tidak cukup!', 'warning');
            }
        }
        
        // Travel to world
        function travelToWorld(worldName) {
            if (playerData.unlocked_worlds.includes(worldName)) {
                playerData.current_world = worldName;
                saveGame();
                updateUI();
                
                showNotification(`Anda menjelajahi ${worldName}!`, 'success');
            } else {
                showNotification('Dunia ini belum terbuka!', 'warning');
            }
        }
        
        // Initialize the game when page loads
        window.onload = initGame;
    </script>
</body>
</html>
